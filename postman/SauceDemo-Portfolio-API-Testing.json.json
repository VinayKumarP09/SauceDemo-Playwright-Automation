							"});\r",
							"\r",
							"// Test 3: Verify user ID\r",
							"pm.test(\"User ID should be 1\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response.userId).to.eql(1);\r",
							"});\r",
							"\r",
							"// Test 4: Verify title is not empty\r",
							"pm.test(\"Title should not be empty\", function () {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response.title).to.not.be.empty;\r",
							"});\r",
							"\r",
							"pm.test(\"Response Content-Type should be JSON\", function () {\r",
							"    const contentType = pm.response.headers.get(\"Content-Type\");\r",
							"    console.log(\"Content-Type:\", contentType);\r",
							"    pm.expect(contentType).to.include(\"application/json\");\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"\r",
							"const schema = {\r",
							"    type: \"object\",\r",
							"    required: [\"userId\", \"id\", \"title\", \"body\"],\r",
							"    properties: {\r",
							"       userId: { type: \"number\" },\r",
							"        id: { type: \"number\" },\r",
							"        title: { type: \"string\" },\r",
							"        body: { type: \"string\" }\r",
